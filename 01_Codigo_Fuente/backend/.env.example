# ---------------------------------------------------------------
# Copia este archivo con el nombre ".env" (sin ".example") y escribe
# tus datos reales. El archivo ".env" NUNCA se sube al repositorio.
# ---------------------------------------------------------------

# Inicio de sesión de SQL Server que creaste para la API (no uses "sa")
DB_USER=usuario_de_sql_server
DB_PASSWORD=contrasena_de_sql_server

# Servidor y base de datos
DB_SERVER=localhost
DB_NAME=NexusPC

# Puerto en el que escucha la API (si no lo pones, usa 3000)
PORT=3000

# ---- Opcionales (quita el # solo si los necesitas) ----
# Instancia con nombre, por ejemplo SQLEXPRESS. También puedes escribir
# DB_SERVER=localhost\SQLEXPRESS y dejar esta línea sin usar.
# DB_INSTANCE=SQLEXPRESS

# Puerto TCP fijo de SQL Server (normalmente 1433). Si lo pones, tiene
# prioridad sobre DB_INSTANCE.
# DB_PORT=1433
